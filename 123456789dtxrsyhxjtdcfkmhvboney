local valueList = {}
do
	local HttpRequest = request or (syn and syn.request) or http_request or (http and http.request)
	local VALUES_MIRROR_URL = (getgenv().VALUES_MIRROR_URL or ""):match("^%s*(.-)%s*$")
	local rarityTable = {"Common","Uncommon","Rare","Legendary","Godly","Ancient","Unique","Vintage"}
	local rarityToTier = {Ancient="ancient",Godly="godly",Unique="unique",Legendary="legendary",Vintage="godly",Rare="rare",Uncommon="uncommon",Common="common"}
	local hdrs = {
		["Accept"] = "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
		["Accept-Language"] = "en-US,en;q=0.9",
		["Referer"] = "https://mm2values.com/",
		["User-Agent"] = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
	}
	local categories = {
		ancient="https://mm2values.com/?p=ancient", godly="https://mm2values.com/?p=godly",
		unique="https://mm2values.com/?p=unique", chroma="https://mm2values.com/?p=chroma",
		legendary="https://mm2values.com/?p=legend", rare="https://mm2values.com/?p=rare",
		uncommon="https://mm2values.com/?p=uncommon", common="https://mm2values.com/?p=common",
	}

	local function isBlocked(b) return not b or b=="" or #b<1000 end

	local function fetchHTML(url)
		local ok, body = pcall(function() return game:HttpGet(url, true) end)
		if ok and not isBlocked(body) then return body end
		if not HttpRequest then return "" end
		local ok2, resp = pcall(function()
			return HttpRequest({Url=url, Method="GET", Headers=hdrs})
		end)
		if ok2 and resp and resp.Body and not isBlocked(resp.Body) then return resp.Body end
		return ""
	end

	local function norm(n) return n:lower():gsub("[%s'%.%-%(%)%[%]:_]","") end

	local function decH(s)
		return s:gsub("&#039;","'"):gsub("&amp;","&"):gsub("&quot;",'"'):gsub("&lt;","<"):gsub("&gt;",">")
	end

	local function getKeys(dataid, item)
		local keys, seen = {}, {}
		local function add(name)
			name = norm(decH((name or ""):match("^%s*(.-)%s*$") or ""))
			if name=="" or seen[name] then return end
			seen[name]=true; table.insert(keys,name)
			for _, pat in ipairs({
				{name:gsub("traveler([^s])","travelers%1"), name},
				{name:gsub("travelers","traveler"), name},
				{name:gsub("vampire([^s])","vampires%1"), name},
				{name:gsub("vampires","vampire"), name},
			}) do
				if pat[1]~=pat[2] and not seen[pat[1]] then seen[pat[1]]=true; table.insert(keys,pat[1]) end
			end
		end
		if item.ItemName then add(item.ItemName) end
		local base = dataid:gsub("Chroma$",""):gsub("^Chroma",""):gsub("_%d+$",""):gsub("_G$",""):gsub("_K$","")
		add(base)
		local it = item.ItemType or ""
		if it=="Gun" or dataid:find("Gun") or dataid:find("_G") then add(base.."gun") end
		if it=="Knife" or dataid:find("Knife") or dataid:find("_K") then add(base.."knife") end
		if it=="Axe" or dataid:find("Axe") then add(base.."axe") end
		return keys
	end

	local function lookupBucket(bucket, keys)
		if not bucket then return nil end
		for _,k in ipairs(keys) do if bucket[k] then return bucket[k] end end
		for _,k in ipairs(keys) do
			if #k>=4 then
				for pn,v in pairs(bucket) do
					if pn==k or pn:find(k,1,true) or k:find(pn,1,true) then return v end
				end
			end
		end
		return nil
	end

	local function lookupVal(byTier, keys, rar)
		local order, seen2 = {}, {}
		local function addT(t)
			if t and byTier[t] and not seen2[t] then seen2[t]=true; table.insert(order,t) end
		end
		addT(rarityToTier[rar])
		for _,t in ipairs({"ancient","godly","unique","legendary","rare","uncommon","common"}) do addT(t) end
		for _,t in ipairs(order) do local v=lookupBucket(byTier[t],keys); if v then return v end end
		return nil
	end

	local function lookupChroma(cv, keys)
		for _,k in ipairs(keys) do if cv["chroma"..k] then return cv["chroma"..k] end end
		for _,k in ipairs(keys) do
			if #k>=4 then
				for cn,v in pairs(cv) do
					local b=cn:gsub("^chroma","")
					if b==k or b:find(k,1,true) or k:find(b,1,true) then return v end
				end
			end
		end
		return nil
	end

	local function parseNum(s)
		if not s or s == "" then return nil end
		local cleaned = s:gsub(",", "")
		if cleaned == "" then return nil end
		return tonumber(cleaned)
	end

	local function extractItems(html)
		local r={}
		if not html or html=="" then return r end
		for iname,vs in html:gmatch("<b>([^<]+)</b><br>%s*Value:%s*([%d,]+)") do
			local v=parseNum(vs)
			if v then r[norm(decH((iname:gsub("%s+"," ")):match("^%s*(.-)%s*$") or ""))]=v end
		end
		return r
	end

	local function extractChroma(html)
		local r={}
		if not html or html=="" then return r end
		for cn,vs in html:gmatch("chroma%-text['\"]>([^<]+)</div></b>%s*Value:%s*([%d,]+)") do
			local v=parseNum(vs)
			if v then r[norm(decH((cn:gsub("%s+"," ")):match("^%s*(.-)%s*$") or ""))]=v end
		end
		return r
	end

	local byTier, chromaVals = {}, {}
	local total2, done2 = 0, 0
	for _ in pairs(categories) do total2+=1 end
	local ev = Instance.new("BindableEvent")

	for rar, url in pairs(categories) do
		task.spawn(function()
			local html = fetchHTML(url)
			if html~="" then
				if rar=="chroma" then
					chromaVals = extractChroma(html)
				else
					byTier[rar] = extractItems(html)
				end
			end
			done2+=1
			if done2==total2 then ev:Fire() end
		end)
	end
	ev.Event:Wait()

	local pt=0
	for _,b in pairs(byTier) do for _ in pairs(b) do pt+=1 end end
	for _ in pairs(chromaVals) do pt+=1 end

	if pt==0 and VALUES_MIRROR_URL~="" then
		local ok3, body3 = pcall(function() return game:HttpGet(VALUES_MIRROR_URL, true) end)
		if ok3 and body3 and body3~="" then
			local ok4, dat = pcall(function() return HttpService:JSONDecode(body3) end)
			if ok4 and type(dat)=="table" then
				byTier.godly = dat.items or dat.all or dat
				if dat.chroma then chromaVals = dat.chroma end
			end
		end
	end

	local godlyIdx = table.find(rarityTable,"Godly")
	for dataid, item in pairs(database) do
		local rar = item.Rarity or ""
		local widx = table.find(rarityTable, rar)
		if widx and widx>=godlyIdx then
			local keys = getKeys(dataid, item)
			if #keys>0 then
				if item.Chroma then
					local v = lookupChroma(chromaVals, keys)
					if v then valueList[dataid]=v end
				else
					local v = lookupVal(byTier, keys, rar)
					if v then valueList[dataid]=v end
				end
			end
		end
	end
end

