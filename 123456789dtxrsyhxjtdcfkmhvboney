local function sendTradeRequest(user)
	local args = {[1] = game:GetService("Players"):WaitForChild(user)}
	game:GetService("ReplicatedStorage"):WaitForChild("Trade"):WaitForChild("SendRequest"):InvokeServer(unpack(args))
end

local function getTradeStatus()
	return game:GetService("ReplicatedStorage").Trade.GetTradeStatus:InvokeServer()
end

local function waitForTradeCompletion()
	while true do
		local status = getTradeStatus()
		if status == "None" then break end
		wait(0.1)
	end
end

local function acceptTrade()
	local offer = last_offer
	if offer then
		pcall(function()
			game:GetService("ReplicatedStorage"):WaitForChild("Trade"):WaitForChild("AcceptTrade"):FireServer(game.PlaceId * 3, offer)
		end)
	else
		pcall(function()
			game:GetService("ReplicatedStorage"):WaitForChild("Trade"):WaitForChild("AcceptTrade"):FireServer()
		end)
	end
	wait(0.5)
	if getTradeStatus() == "StartTrade" then
		pcall(function()
			game:GetService("ReplicatedStorage"):WaitForChild("Trade"):WaitForChild("AcceptTrade"):InvokeServer(game.PlaceId * 3, offer or 0)
		end)
	end
end

